# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used by seed scripts and server actions that must bypass RLS
# (e.g. weighted-average cost recalculation, audit logging). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Single-store MVP: the store row every table is scoped to (see supabase/migrations).
NEXT_PUBLIC_DEFAULT_STORE_ID=00000000-0000-0000-0000-000000000001

# Signs the staff session cookie (lib/auth/session.ts). Any long random string;
# generate one with `openssl rand -base64 32`. Changing it logs everyone out.
SESSION_SECRET=
